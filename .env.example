MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# XAMPP on macOS can use MYSQL_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock
MYSQL_SOCKET=
MYSQL_DATABASE=shaheenautomotive
MYSQL_USER=shaheen_app
MYSQL_PASSWORD=
# Set to 1 for hosts requiring TLS with a trusted certificate.
MYSQL_TLS=0
APP_ORIGIN=http://localhost:3000
RESEND_API_KEY=
PASSWORD_RESET_FROM=
